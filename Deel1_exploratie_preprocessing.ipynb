    "paired = (meta[meta[\"visit_day\"].isin([\"Day 0\", \"Day 7\"])]\n",
    "          .assign(round_=lambda d: d[\"sample.visitName\"].str.replace(r\" Day \\d+\", \"\", regex=True))\n",
    "          .pivot_table(index=[\"subject.subjectGuid\", \"round_\"], columns=\"visit_day\", values=\"log_crp\")\n",
    "          .dropna())\n",
    "print(\"Paired Wilcoxon day 0 vs day 7 (n =\", len(paired), \"pairs):\",\n",
