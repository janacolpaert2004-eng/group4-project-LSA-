   ],
   "source": [
    "meta[\"log_crp\"]    = np.log10(meta[\"infl.hs_crp\"])\n",
    "meta[\"crp_acute\"]  = meta[\"infl.hs_crp\"] >= 10\n",
    "meta[\"crp_at_lod\"] = meta[\"infl.hs_crp\"] <= 0.3\n",
    "meta[\"crp_cat\"]    = pd.cut(meta[\"infl.hs_crp\"], bins=[0, 1, 3, np.inf], right=False,\n",
