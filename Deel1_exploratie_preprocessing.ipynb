   "source": [
    "def robust_z(x):\n",
    "    mad = stats.median_abs_deviation(x, scale=\"normal\")\n",
    "    return (x - np.median(x)) / mad\n",
    "\n",
    "qc = pd.DataFrame({\n",
    "    \"pct_below_lod\": meta[\"pct_below_lod\"],\n",
    "    \"median_npx\": npx_f.median(axis=1),\n",
    "    \"batch\": meta[\"olink_batch_id\"],\n",
    "})\n",
    "qc[\"z_lod\"] = robust_z(qc[\"pct_below_lod\"])\n",
    "qc[\"z_median\"] = robust_z(qc[\"median_npx\"])\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(13, 3.8))\n",
    "sns.boxplot(data=qc, x=\"batch\", y=\"pct_below_lod\", ax=ax[0], color=\"lightgrey\")\n",
    "ax[0].set(title=\"% proteins below LOD per sample\", xlabel=\"Olink batch\", ylabel=\"% below LOD\")\n",
    "sns.boxplot(data=qc, x=\"batch\", y=\"median_npx\", ax=ax[1], color=\"lightgrey\")\n",
    "ax[1].set(title=\"Median NPX per sample\", xlabel=\"Olink batch\", ylabel=\"Median NPX\")\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "print(\"Samples with |robust z| > 4 for % below LOD:\", (qc[\"z_lod\"].abs() > 4).sum())\n",
    "print(\"Samples with |robust z| > 4 for median NPX:\", (qc[\"z_median\"].abs() > 4).sum())"
   ]
  },
