      "At upper limit (>= 10 mg/L): 13\n"
     ]
    }
   ],
   "source": [
    "crp = meta[\"infl.hs_crp\"]\n",
    "print(crp.describe().round(2))\n",
    "print(\"\\nMissing:\", crp.isna().sum())\n",
    "print(\"At lower limit (0.3 mg/L):\", (crp == 0.3).sum(), f\"({(crp == 0.3).mean()*100:.0f}%)\")\n",
    "print(\"At upper limit (>= 10 mg/L):\", (crp >= 10).sum())"
   ]
