   "source": [
    "paren = annot.loc[annot[\"same_assay_as\"].notna() & (annot[\"pct_missing\"] < 50), [\"protein\", \"same_assay_as\"]]\n",
    "\n",
    "npx_clean = npx.copy()\n",
    "for nieuw, oud in paren.itertuples(index=False):\n",
    "    # Controle: de twee kolommen mogen nooit tegelijk een waarde hebben\n",
    "    assert (npx[nieuw].notna() & npx[oud].notna()).sum() == 0\n",
    "    npx_clean[nieuw] = npx_clean[nieuw].fillna(npx_clean[oud])\n",
    "    npx_clean = npx_clean.drop(columns=oud)\n",
    "\n",
    "annot_clean = annot[annot[\"protein\"].isin(npx_clean.columns)].set_index(\"protein\")\n",
    "\n",
    "nog_na = npx_clean.columns[npx_clean.isna().any()]\n",
    "print(\"Proteins after merging:\", npx_clean.shape[1], \"(= 1472 analytes of the Explore 1536 panel)\")\n",
    "print(\"Proteins still containing NA (batch not measured):\", len(nog_na))"
   ]
  },
